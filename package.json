{
  "name": "atlas-notebook",
  "private": true,
  "version": "1.2.0",
  "description": "ATLAS — Adaptive Thinking, Learning, and Assessment System",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/radiumQCO/ATLAS-Adaptive-Thinking-Learning-Assessment-System.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 1420 --strictPort",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build && node scripts/copy-root-exe.mjs",
    "test": "vitest run tests/logic.test.ts --configLoader runner",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.json *.ts *.html *.md"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "dexie": "^4.4.6",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
